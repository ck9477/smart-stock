# SmartStock Backend — Environment Variables
#
# Copy to .env for local development outside Docker.
# When running via docker compose, these are passed from the root .env.

# Database (MSSQL)
DB_SERVER=db
DB_PORT=1433
DB_NAME=SmartStock
DB_USERNAME=sa
DB_PASSWORD=SmartStock123!
DB_TRUSTED_CONNECTION=no
DB_DRIVER=ODBC Driver 18 for SQL Server

# Flask
FLASK_ENV=development
FLASK_PORT=5000
