import json
from sqlalchemy.exc import SQLAlchemyError
from Repository.receipts import ReceiptRepository
from Repository.Reception_products import ReceptionProductsRepository
from Repository.Products import ProductRepository
from models.receipts import Receipt
from models.Reception_products import ReceptionProducts


class ReceiptService:
    def __init__(self, session):
        self.session = session
        self.receipt_repo = ReceiptRepository(session)
        self.reception_repo = ReceptionProductsRepository(session)
        self.product_repo = ProductRepository(session)

    def create_receipt(self, user_id: int):
        receipt = Receipt(user_id=user_id)
        self.receipt_repo.add_receipt(receipt)
        self.session.commit()
        return receipt.id

    def process_receipt(self, receipt_file, user_id: int):
        products = self.parse_receipt_file(receipt_file)
        if not products:
            raise ValueError("No products found in the receipt file")

        receipt = Receipt(user_id=user_id)
        self.receipt_repo.add_receipt(receipt)
        self.session.flush()
        receipt_id = receipt.id

        reception_items = []
        for raw_product in products:
            if not isinstance(raw_product, dict):
                raise ValueError("Each receipt product must be an object")

            product = self.find_product(raw_product)
            amount = self.parse_amount(raw_product.get("amount"))
            reception = ReceptionProducts(
                receipts_id=receipt_id,
                products_id=product.id,
                amount=amount
            )
            reception_items.append(reception)

        self.reception_repo.add_items(reception_items)
        try:
            self.session.commit()
        except SQLAlchemyError as exc:
            self.session.rollback()
            raise exc

        return {
            "receipt_id": receipt_id,
            "products": [
                {
                    "reception_id": item.id,
                    "product_id": item.products_id,
                    "amount": item.amount
                }
                for item in reception_items
            ]
        }

    def save_receipt_products(self, receipt_id: int, products: list[dict]):
        receipt = self.receipt_repo.get_receipt_by_id(receipt_id)
        if receipt is None:
            raise ValueError("Receipt not found")

        reception_items = []
        for raw_product in products:
            if not isinstance(raw_product, dict):
                raise ValueError("Each product must be an object")

            product = self.find_product(raw_product)
            amount = self.parse_amount(raw_product.get("amount"))
            reception = ReceptionProducts(
                receipts_id=receipt_id,
                products_id=product.id,
                amount=amount
            )
            reception_items.append(reception)

        self.reception_repo.add_items(reception_items)
        return {
            "receipt_id": receipt_id,
            "products": [
                {
                    "reception_id": item.id,
                    "product_id": item.products_id,
                    "amount": item.amount
                }
                for item in reception_items
            ]
        }

    def update_receipt(self, receipt_id: int, user_id: int | None = None):
        updated_fields = {}
        if user_id is not None:
            updated_fields["user_id"] = user_id

        receipt = self.receipt_repo.update_receipt(receipt_id, **updated_fields)
        if receipt is None:
            raise ValueError("Receipt not found")
        return {
            "id": receipt.id,
            "user_id": receipt.user_id,
            "receipt_date": receipt.receipt_date.isoformat()
        }

    def update_reception_product(self, item_id: int, product_id: int | None = None, amount: int | None = None):
        updates = {}
        if product_id is not None:
            updates["products_id"] = product_id
        if amount is not None:
            updates["amount"] = self.parse_amount(amount)

        item = self.reception_repo.update_item(item_id, **updates)
        if item is None:
            raise ValueError("Reception product item not found")

        return {
            "id": item.id,
            "receipt_id": item.receipts_id,
            "product_id": item.products_id,
            "amount": item.amount
        }

    def find_product(self, raw_product: dict):
        product_id = raw_product.get("product_id")
        product_code = raw_product.get("product_code") or raw_product.get("code")
        product_name = raw_product.get("product_name") or raw_product.get("name")

        if product_id is not None:
            product = self.product_repo.get_by_id(int(product_id))
            if product:
                return product

        if product_code:
            product = self.product_repo.get_by_code(product_code)
            if product:
                return product

        if product_name:
            product = self.product_repo.get_by_name(product_name)
            if product:
                return product

        raise ValueError("Product not found for one or more receipt items")

    def parse_amount(self, amount):
        if amount is None:
            return 1
        try:
            parsed = int(amount)
            return max(parsed, 1)
        except (TypeError, ValueError):
            raise ValueError(f"Invalid amount value: {amount}")

    def parse_receipt_file(self, receipt_file):
        receipt_file.stream.seek(0)
        raw_data = receipt_file.read()
        if isinstance(raw_data, bytes):
            try:
                content = raw_data.decode("utf-8")
            except UnicodeDecodeError:
                content = raw_data.decode("utf-8", errors="ignore")
        else:
            content = str(raw_data)

        receipt_file.stream.seek(0)
        if not content or not content.strip():
            return []

        try:
            payload = json.loads(content)
            if isinstance(payload, dict) and "products" in payload:
                return payload["products"]
            if isinstance(payload, list):
                return payload
        except json.JSONDecodeError:
            pass

        lines = [line.strip() for line in content.splitlines() if line.strip()]
        parsed_products = []
        for line in lines:
            parts = [part.strip() for part in line.replace(";", ",").split(",") if part.strip()]
            if len(parts) == 2:
                identifier, amount = parts
                if identifier.isdigit():
                    parsed_products.append({"product_id": int(identifier), "amount": amount})
                else:
                    parsed_products.append({"product_code": identifier, "amount": amount})
            elif len(parts) >= 3:
                parsed_products.append({"product_code": parts[0], "product_name": parts[1], "amount": parts[2]})

        return parsed_products
